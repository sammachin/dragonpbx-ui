<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DragonPBX</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
<nav class="bg-white border-b border-gray-200 px-6 py-4">
<div class="flex items-center justify-between">
<!-- Logo on the left -->
<div class="flex items-center gap-3">
<img src="/images/logo.png" width="50" height="50">
<h1 class="text-2xl font-bold text-gray-900">DragonPBX</h1>
</div>
<!-- Menu items on the right -->
<% if (typeof currentUser !== 'undefined') { %>
<div class="flex gap-4">
<a href="/domains" class="text-gray-700 hover:text-blue-600">
<i class="fas fa-list mr-1"></i>Domains
</a>
<% if (typeof currentUser !== 'undefined' && currentUser.role === 'admin') { %>
<a href="/users" class="text-gray-700 hover:text-blue-600">
<i class="fas fa-users mr-1"></i>Users
</a>
<% } %>
<a href="/logout" class="text-red-600 hover:text-red-800">
<i class="fas fa-sign-out-alt mr-2"></i>Logout
</a>
</div>
<% } %>
</div>
</nav>
<main>
<%- body %>
</main>
<script src="/js/app.js"></script>
</body>
</html>