<div class="container mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-3xl font-bold text-gray-900">Domains</h2>
    <a href="/domains/new" class="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
      <i class="fas fa-plus"></i>
      Add Domain
    </a>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% if (domains.length === 0) { %>
      <div class="col-span-full text-center py-12 text-gray-400">
        <i class="fas fa-globe text-6xl mb-4 opacity-50"></i>
        <p class="text-lg">No domains yet. Create your first domain!</p>
      </div>
    <% } %>
    
    <% domains.forEach(function(domain) { %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between mb-3">
          <div class="flex-1">
            <h3 class="font-semibold text-gray-900 text-lg"><%= domain.domain %></h3>
            <p class="text-xs text-gray-500">ID: <%= domain.id %></p>
          </div>
          <form action="/api/domains/<%= domain.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this domain?');">
            <button type="submit" class="text-red-500 hover:text-red-700">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </div>
        
        <div class="flex gap-4 text-sm text-gray-600 mb-3">
          <span><i class="fas fa-users mr-1"></i><%= domain.clients.length %> clients</span>
          <span><i class="fas fa-phone mr-1"></i><%= domain.trunks.length %> trunks</span>
        </div>
        
        <div class="flex gap-2">
          <a href="/domains/<%= domain.id %>" class="flex-1 text-center px-3 py-2 bg-blue-50 text-blue-600 rounded hover:bg-blue-100">
            <i class="fas fa-eye mr-1"></i>Manage
          </a>
          <a href="/domains/<%= domain.id %>/edit" class="flex-1 text-center px-3 py-2 bg-gray-50 text-gray-600 rounded hover:bg-gray-100">
            <i class="fas fa-edit mr-1"></i>Rename
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</div>