<div class="container mx-auto px-6 py-8 max-w-6xl">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-3xl font-bold text-gray-900"><%= domain.domain %>
       <% if (typeof currentUser !== 'undefined' && currentUser.role === 'admin') { %>
          <a href="/domains/<%= domain.id %>/edit" class=" text-xl flex-1 bg-gray-50 text-gray-600 rounded hover:bg-gray-100">
            <i class="fas fa-edit mr-1"></i>
          </a>
          <% } %>
      </h2>
      <p class="text-gray-500 mt-1">Domain ID: <%= domain.id %></p>
    </div>
         
    <div class="flex gap-2">
      <a href="/domains" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
        <i class="fas fa-arrow-left mr-2"></i>Back to List
      </a>
    </div>
  </div>
  
  <!-- Clients Section -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <i class="fas fa-users text-gray-700"></i>
        <h3 class="text-xl font-semibold text-gray-900">Clients</h3>
        <span class="text-sm text-gray-500">(<%= domain.clients.length %>)</span>
      </div>
      <button onclick="toggleClientForm()" class="px-3 py-1.5 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm">
        <i class="fas fa-plus mr-2"></i>Add Client
      </button>
    </div>
    
    <!-- Add Client Form -->
    <div id="clientForm" class="hidden mb-4 bg-white rounded-lg shadow-sm border-2 border-green-500 p-4">
      <h4 class="font-semibold mb-3" id="clientFormTitle">New Client</h4>
      <form action="/api/domains/<%= domain.id %>/clients" method="POST" id="addClientForm">
        <input type="hidden" name="_csrf" value="<%= typeof _csrf !== 'undefined' ? _csrf : '' %>">
        <input type="hidden" name="_method" id="clientFormMethod" value="">
        <input type="hidden" name="clientId" id="clientId" value="">
        
        <!-- Label Field -->
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-1">Label</label>
          <input type="text" name="label" id="clientLabel" required placeholder="e.g., Main Reception Phone" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
        </div>
        
        <!-- Auth Type Selection -->
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">Authentication Type</label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="authType" value="standard" checked onchange="toggleAuthFields()">
              <span class="text-sm">Standard (Password + Codecs)</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="authType" value="reghook" onchange="toggleAuthFields()">
              <span class="text-sm">RegHook (URL-based)</span>
            </label>
          </div>
        </div>
        
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
          <input type="text" name="username" id="clientUsername" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
        </div>
        
        <!-- Standard Auth Fields -->
        <div id="standardAuthFields">
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input type="password" name="password" id="passwordField" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          </div>
          
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 mb-2">Codecs</label>
            <div class="flex gap-4">
              <div class="flex-1">
                <div class="text-xs text-gray-500 mb-1">Available</div>
                <div id="codecAvailable" class="border border-gray-200 rounded-lg p-2 min-h-[60px] space-y-1">
                  <% allowedCodecs.forEach(function(codec) { %>
                    <button type="button" data-codec="<%= codec %>" onclick="addCodec('<%= codec %>')" class="codec-available-item w-full text-left px-3 py-1.5 bg-gray-100 rounded hover:bg-blue-100 text-sm cursor-pointer">
                      <%= codec %>
                    </button>
                  <% }); %>
                </div>
              </div>
              <div class="flex-1">
                <div class="text-xs text-gray-500 mb-1">Selected (in priority order)</div>
                <div id="codecSelected" class="border border-gray-200 rounded-lg p-2 min-h-[60px] space-y-1">
                </div>
              </div>
            </div>
          </div>
          
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 mb-2">Dialplan Routes</label>
            <div id="dialplanEntries" class="space-y-2 mb-2">
              <!-- Dialplan entries will be added here -->
            </div>
            <div class="flex gap-2">
              <input 
                type="text" 
                id="dialplanDigits" 
                placeholder="Digits (e.g., 1234)" 
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <input 
                type="url" 
                id="dialplanUrl" 
                placeholder="URL (e.g., https://example.com/route)" 
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <button type="button" onclick="addDialplanEntry()" class="px-3 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 text-sm">
                <i class="fas fa-plus"></i>
              </button>
            </div>
            <input type="hidden" name="dialplan" id="dialplanHidden" value="{}">
            <p class="text-xs text-gray-500 mt-1">Add routing rules with digit patterns and destination URLs</p>
          </div>
        </div>
        
        <!-- RegHook Auth Fields -->
        <div id="reghookAuthFields" class="hidden">
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">RegHook URL</label>
            <input type="url" name="reghook" id="reghookField" placeholder="https://example.com/register" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <p class="text-xs text-gray-500 mt-1">URL to be called for registration authentication</p>
          </div>
        </div>
        
        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm">
            <i class="fas fa-save mr-2"></i>Save
          </button>
          <button type="button" onclick="cancelClientEdit()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">
            <i class="fas fa-times mr-2"></i>Cancel
          </button>
        </div>
      </form>
    </div>
    
    <!-- Clients List -->
    <div class="space-y-3">
      <% if (domain.clients.length === 0) { %>
        <p class="text-gray-500 text-center py-8">No clients yet. Add your first client!</p>
      <% } %>
      
      <% domain.clients.forEach(function(client) { %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <h4 class="font-semibold text-gray-900 text-lg"><%= client.label %></h4>
                <span class="text-xs bg-gray-100 px-2 py-1 rounded">ID: <%= client.id %></span>
                <% if (client.authType === 'standard') { %>
                  <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded">Standard Auth</span>
                <% } else { %>
                  <span class="text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded">RegHook Auth</span>
                <% } %>
              </div>
              
              <div class="text-sm text-gray-600 mb-2">
                <span class="font-medium">Username:</span> <span class="font-mono"><%= client.username %></span>
              </div>
              
              <% if (client.authType === 'standard') { %>
                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div>
                    <span class="text-gray-500">Password:</span>
                    <span class="ml-2 font-mono">••••••••</span>
                  </div>
                  <div>
                    <span class="text-gray-500">Codecs:</span>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <% if (client.codecs && client.codecs.length > 0) { %>
                        <% client.codecs.forEach(function(codec) { %>
                          <span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-xs"><%= codec %></span>
                        <% }); %>
                      <% } else { %>
                        <span class="text-gray-400 text-xs">None</span>
                      <% } %>
                    </div>
                  </div>
                </div>
                
                <% if (client.dialplan && Object.keys(client.dialplan).length > 0) { %>
                  <div class="mt-3 text-sm">
                    <span class="text-gray-500">Dialplan Routes:</span>
                    <div class="mt-1 space-y-1">
                      <% Object.entries(client.dialplan).forEach(function([digits, url]) { %>
                        <div class="bg-gray-50 rounded p-2 flex items-center justify-between">
                          <div class="flex-1">
                            <span class="font-semibold text-gray-700"><%= digits %></span>
                            <span class="mx-2 text-gray-400">→</span>
                            <span class="text-xs text-gray-600 break-all"><%= url %></span>
                          </div>
                        </div>
                      <% }); %>
                    </div>
                  </div>
                <% } %>
              <% } else { %>
                <div class="text-sm">
                  <span class="text-gray-500">RegHook URL:</span>
                  <div class="bg-purple-50 rounded p-2 mt-1 font-mono text-xs break-all">
                    <%= client.reghook %>
                  </div>
                </div>
              <% } %>
            </div>
            
            <div class="flex gap-2">
              <button onclick="editClient(<%= client.id %>, '<%= client.label %>', '<%= client.username %>', '<%= client.authType %>', '<%= client.password || '' %>', '<%= client.reghook || '' %>', <%= JSON.stringify(client.codecs || []) %>, <%= JSON.stringify(client.dialplan || {}) %>)" class="text-blue-600 hover:text-blue-800">
                <i class="fas fa-edit"></i>
              </button>
              <form action="/api/clients/<%= client.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this client?');">
                <button type="submit" class="text-red-600 hover:text-red-800">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  
  <!-- Trunks Section -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <i class="fas fa-phone text-gray-700"></i>
        <h3 class="text-xl font-semibold text-gray-900">Trunks</h3>
        <span class="text-sm text-gray-500">(<%= domain.trunks.length %>)</span>
      </div>
      <button onclick="toggleTrunkForm()" class="px-3 py-1.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 text-sm">
        <i class="fas fa-plus mr-2"></i>Add Trunk
      </button>
    </div>
    
    <!-- Add Trunk Form -->
    <div id="trunkForm" class="hidden mb-4 bg-white rounded-lg shadow-sm border-2 border-purple-500 p-4">
      <h4 class="font-semibold mb-3" id="trunkFormTitle">New Trunk</h4>
      <form action="/api/domains/<%= domain.id %>/trunks" method="POST" id="addTrunkForm">
        <input type="hidden" name="_csrf" value="<%= typeof _csrf !== 'undefined' ? _csrf : '' %>">
        <input type="hidden" name="_method" id="trunkFormMethod" value="">
        <input type="hidden" name="trunkId" id="trunkId" value="">
        <input type="hidden" name="authType" id="authTypeHidden" value="ip">
        
        <!-- Label Field -->
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-1">Label</label>
          <input type="text" name="label" id="trunkLabel" required placeholder="e.g., Main SIP Provider" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
        </div>

        <!-- Authentication Type Field -->
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-2">Authentication Type</label>
          <div class="flex gap-3">
            <label class="flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200 cursor-pointer">
              <input type="radio" name="trunkAuthType" value="ip" id="trunkAuthTypeIp" checked onchange="toggleTrunkAuthType()" class="text-purple-600">
              <span class="text-sm font-medium">IP-based</span>
            </label>
            <label class="flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200 cursor-pointer">
              <input type="radio" name="trunkAuthType" value="authentication" id="trunkAuthTypeAuthentication" onchange="toggleTrunkAuthType()" class="text-purple-600">
              <span class="text-sm font-medium">Authentication</span>
            </label>
            <label class="flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200 cursor-pointer">
              <input type="radio" name="trunkAuthType" value="registration" id="trunkAuthTypeRegistration" onchange="toggleTrunkAuthType()" class="text-purple-600">
              <span class="text-sm font-medium">Registration</span>
            </label>
          </div>
        </div>

        <!-- Inbound Authentication Section -->
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-2">Inbound Authentication</label>

          <!-- IP-based Fields (shown by default) -->
          <div id="ipBasedFields">
            <div id="inboundEntries" class="space-y-2 mb-2">
              <!-- Inbound entries will be added here -->
            </div>
            <div class="flex gap-2">
              <input
                type="text"
                id="inboundIp"
                placeholder="192.168.1.0/24"
                pattern="^(\d{1,3}\.){3}\d{1,3}\/\d{1,2}$"
                class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono"
              />
              <button type="button" onclick="addInboundEntry()" class="px-3 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm">
                <i class="fas fa-plus"></i>
              </button>
            </div>
            <input type="hidden" name="inbound" id="inboundHidden" value="[]">
            <p class="text-xs text-gray-500 mt-1">Add allowed inbound IP addresses in CIDR notation</p>
          </div>

          <!-- Authentication Fields (hidden by default) -->
          <div id="authenticationFields" class="hidden">
            <div class="space-y-2 bg-gray-50 p-3 rounded-lg">
              <input
                type="text"
                name="authenticationUsername"
                id="authenticationUsername"
                placeholder="Username"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <input
                type="password"
                name="authenticationPassword"
                id="authenticationPassword"
                placeholder="Password"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
            </div>
          </div>

          <!-- Registration Fields (hidden by default) -->
          <div id="registrationFields" class="hidden">
            <div class="space-y-2 bg-gray-50 p-3 rounded-lg">
              <input
                type="text"
                name="registrationUsername"
                id="registrationUsername"
                placeholder="Username"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <input
                type="password"
                name="registrationPassword"
                id="registrationPassword"
                placeholder="Password"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <input
                type="text"
                name="registrationServer"
                id="registrationServer"
                placeholder="Server (e.g., sip.provider.com)"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
            </div>
          </div>
        </div>

        <!-- Outbound Configuration (always visible) -->
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-2">Outbound Configuration</label>
          <div class="space-y-2">
            <input
              type="text"
              name="outboundHost"
              id="outboundHost"
              placeholder="Host (e.g., sip.provider.com)"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
            />
            <div class="grid grid-cols-2 gap-2">
              <input
                type="text"
                name="outboundUsername"
                id="outboundUsername"
                placeholder="Username (optional)"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
              <input
                type="password"
                name="outboundPassword"
                id="outboundPassword"
                placeholder="Password (optional)"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm"
              />
            </div>
          </div>
          <input type="hidden" name="outbound" id="outboundHidden">
        </div>
        
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-2">Codecs</label>
          <div class="flex gap-4">
            <div class="flex-1">
              <div class="text-xs text-gray-500 mb-1">Available</div>
              <div id="trunkCodecAvailable" class="border border-gray-200 rounded-lg p-2 min-h-[60px] space-y-1">
                <% allowedCodecs.forEach(function(codec) { %>
                  <button type="button" data-codec="<%= codec %>" onclick="addTrunkCodec('<%= codec %>')" class="trunk-codec-available-item w-full text-left px-3 py-1.5 bg-gray-100 rounded hover:bg-blue-100 text-sm cursor-pointer">
                    <%= codec %>
                  </button>
                <% }); %>
              </div>
            </div>
            <div class="flex-1">
              <div class="text-xs text-gray-500 mb-1">Selected (in priority order)</div>
              <div id="trunkCodecSelected" class="border border-gray-200 rounded-lg p-2 min-h-[60px] space-y-1">
              </div>
            </div>
          </div>
        </div>
        
        <div class="mb-3">
          <label class="block text-sm font-medium text-gray-700 mb-2">Dialplan Routes</label>
          <div id="trunkDialplanEntries" class="space-y-2 mb-2">
            <!-- Trunk dialplan entries will be added here -->
          </div>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="trunkDialplanDigits" 
              placeholder="Digits (e.g., 1234)" 
              class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
            />
            <input 
              type="url" 
              id="trunkDialplanUrl" 
              placeholder="URL (e.g., https://example.com/route)" 
              class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm"
            />
            <button type="button" onclick="addTrunkDialplanEntry()" class="px-3 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 text-sm">
              <i class="fas fa-plus"></i>
            </button>
          </div>
          <input type="hidden" name="dialplan" id="trunkDialplanHidden" value="{}">
          <p class="text-xs text-gray-500 mt-1">Add routing rules with digit patterns and destination URLs</p>
        </div>
        
        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 text-sm">
            <i class="fas fa-save mr-2"></i>Save
          </button>
          <button type="button" onclick="cancelTrunkEdit()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">
            <i class="fas fa-times mr-2"></i>Cancel
          </button>
        </div>
      </form>
    </div>
    
    <!-- Trunks List -->
    <div class="space-y-3">
      <% if (domain.trunks.length === 0) { %>
        <p class="text-gray-500 text-center py-8">No trunks yet. Add your first trunk!</p>
      <% } %>
      
      <% domain.trunks.forEach(function(trunk) { %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <h4 class="font-semibold text-gray-900 text-lg"><%= trunk.label %></h4>
                <span class="text-xs bg-gray-100 px-2 py-1 rounded">ID: <%= trunk.id %></span>
                <span class="text-xs <%= (trunk.authType === 'registration') ? 'bg-blue-100 text-blue-700' : (trunk.authType === 'authentication') ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700' %> px-2 py-1 rounded font-medium">
                  <%= (trunk.authType === 'registration') ? 'Registration' : (trunk.authType === 'authentication') ? 'Authentication' : 'IP-based' %>
                </span>
              </div>

              <!-- Inbound Authentication Display -->
              <div class="mb-3">
                <span class="text-gray-500 font-medium text-sm">Inbound Authentication:</span>
                <% if (trunk.authType === 'registration') { %>
                  <!-- Registration display -->
                  <div class="mt-1 space-y-2">
                    <div class="bg-blue-50 text-blue-700 px-3 py-2 rounded text-xs">
                      <div class="font-semibold">Username:</div>
                      <div class="font-mono"><%= trunk.registrationUsername || 'N/A' %></div>
                    </div>
                    <div class="bg-purple-50 text-purple-700 px-3 py-2 rounded text-xs">
                      <div class="font-semibold">Server:</div>
                      <div class="font-mono"><%= trunk.registrationServer || 'N/A' %></div>
                    </div>
                  </div>
                <% } else if (trunk.authType === 'authentication') { %>
                  <!-- Authentication display -->
                  <div class="mt-1">
                    <div class="bg-yellow-50 text-yellow-700 px-3 py-2 rounded text-xs">
                      <div class="font-semibold">Username:</div>
                      <div class="font-mono"><%= trunk.authenticationUsername || 'N/A' %></div>
                    </div>
                  </div>
                <% } else { %>
                  <!-- IP-based display -->
                  <div class="mt-1 space-y-1">
                    <% if (trunk.inbound && trunk.inbound.length > 0) { %>
                      <% trunk.inbound.forEach(function(ip) { %>
                        <div class="bg-green-50 text-green-700 px-2 py-1 rounded font-mono text-xs">
                          <%= ip %>
                        </div>
                      <% }); %>
                    <% } else { %>
                      <span class="text-gray-400 text-xs">None</span>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <!-- Outbound Configuration (always shown) -->
              <div class="mb-3">
                <span class="text-gray-500 font-medium text-sm">Outbound:</span>
                <div class="mt-1 bg-purple-50 text-purple-700 px-2 py-1 rounded text-xs">
                  <div class="font-mono"><%= trunk.outbound.host || 'Not configured' %></div>
                  <% if (trunk.outbound.username) { %>
                    <div class="text-xs mt-1">User: <%= trunk.outbound.username %></div>
                  <% } %>
                </div>
              </div>
              
              <div class="mt-3 text-sm">
                <span class="text-gray-500">Codecs:</span>
                <div class="flex flex-wrap gap-1 mt-1">
                  <% if (trunk.codecs && trunk.codecs.length > 0) { %>
                    <% trunk.codecs.forEach(function(codec) { %>
                      <span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-xs"><%= codec %></span>
                    <% }); %>
                  <% } else { %>
                    <span class="text-gray-400 text-xs">None</span>
                  <% } %>
                </div>
              </div>
              
              <% if (trunk.dialplan && Object.keys(trunk.dialplan).length > 0) { %>
                <div class="mt-3 text-sm">
                  <span class="text-gray-500">Dialplan Routes:</span>
                  <div class="mt-1 space-y-1">
                    <% Object.entries(trunk.dialplan).forEach(function([digits, url]) { %>
                      <div class="bg-gray-50 rounded p-2 flex items-center justify-between">
                        <div class="flex-1">
                          <span class="font-semibold text-gray-700"><%= digits %></span>
                          <span class="mx-2 text-gray-400">→</span>
                          <span class="text-xs text-gray-600 break-all"><%= url %></span>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% } %>
            </div>
            
            <div class="flex gap-2">
              <button
                data-trunk-id="<%= trunk.id %>"
                data-trunk-label="<%= trunk.label %>"
                data-trunk-authtype="<%= trunk.authType || 'ip' %>"
                data-trunk-inbound='<%= JSON.stringify(trunk.inbound || []) %>'
                data-trunk-outbound='<%= JSON.stringify(trunk.outbound) %>'
                data-trunk-codecs='<%= JSON.stringify(trunk.codecs || []) %>'
                data-trunk-dialplan='<%= JSON.stringify(trunk.dialplan || {}) %>'
                data-trunk-auth-username="<%= trunk.authenticationUsername || '' %>"
                data-trunk-auth-password="<%= trunk.authenticationPassword || '' %>"
                data-trunk-reg-username="<%= trunk.registrationUsername || '' %>"
                data-trunk-reg-password="<%= trunk.registrationPassword || '' %>"
                data-trunk-reg-server="<%= trunk.registrationServer || '' %>"
                onclick="editTrunkFromData(this)"
                class="text-blue-600 hover:text-blue-800">
                <i class="fas fa-edit"></i>
              </button>
              <form action="/api/trunks/<%= trunk.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this trunk?');">
                <button type="submit" class="text-red-600 hover:text-red-800">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<!-- Pass domain ID to JavaScript -->
<div data-domain-id="<%= domain.id %>" style="display: none;"></div>