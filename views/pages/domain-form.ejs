<div class="container mx-auto px-6 py-8 max-w-2xl">
  <h2 class="text-3xl font-bold text-gray-900 mb-6">
    <%= typeof domain !== 'undefined' ? 'Edit Domain' : 'New Domain' %>
  </h2>
  
  <form action="<%= typeof domain !== 'undefined' ? '/api/domains/' + domain.id + '?_method=PUT' : '/api/domains' %>" method="POST" class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="mb-4">
      <label for="domain" class="block text-sm font-medium text-gray-700 mb-2">
        Domain (hostname or IPv4)
      </label>
      <input 
        type="text" 
        id="domain" 
        name="domain" 
        value="<%= typeof domain !== 'undefined' ? domain.domain : '' %>"
        placeholder="foo.example.com or 192.168.1.1"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
      />
    </div>
    
    <div class="flex gap-2">
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
        <i class="fas fa-save mr-2"></i>Save
      </button>
      <a href="/domains" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
        <i class="fas fa-times mr-2"></i>Cancel
      </a>
    </div>
  </form>
</div>