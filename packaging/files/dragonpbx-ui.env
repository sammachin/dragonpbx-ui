# DragonPBX UI (Sails) runtime environment — sourced by dragonpbx-ui.service.
# This is a dpkg conffile; edits survive upgrades.

NODE_ENV=production

# HTTP port (Sails reads PORT). The main DragonPBX app's CONFIG_URL points here.
PORT=1337

# Interface to bind. Defaults to 127.0.0.1 (reachable only via the nginx proxy).
# Set HOST=0.0.0.0 to listen on all interfaces (e.g. if not using nginx).
# HOST=127.0.0.1

# sails-disk datastore location — kept outside the app dir so package upgrades
# don't wipe stored domains/tokens. (Consumed by config/zz-packaged-datastore.js.)
DRAGONPBX_UI_DB_DIR=/var/lib/dragonpbx-ui/db

# Restrict websocket origins (comma-separated). Required by Sails in production;
# left unset the package allows all connections (fine for an internal single-host
# admin API). Set to lock down, e.g. https://pbx.example.com
# DRAGONPBX_UI_ORIGINS=https://pbx.example.com

# Codecs advertised by the UI (defaults shown). Uncomment to override.
# ALLOWED_CODECS=PCMU,PCMA,G722,opus,GSM,direct
